<Window x:Class="IFAS.LicenseCreator.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="IFAS License Creator" Width="900" Height="680" WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="White">
<Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="IFAS LICENSE CREATOR" FontSize="28" FontWeight="Bold"/><TextBlock Text="SUPPLIER ONLY • Private signing key stays on this machine" Foreground="#7DBBFF" Margin="0,3,0,16"/></StackPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel Grid.Column="0" Margin="0,0,10,0"><TextBlock Text="Customer" FontWeight="Bold"/><TextBox x:Name="CustomerBox" Margin="0,5,0,12"/><TextBlock Text="Contact Person"/><TextBox x:Name="ContactBox" Margin="0,5,0,12"/><TextBlock Text="Maximum Users"/><TextBox x:Name="UsersBox" Text="10" Margin="0,5,0,12"/><TextBlock Text="Maximum Cameras"/><TextBox x:Name="CamerasBox" Text="32" Margin="0,5,0,12"/></StackPanel>
<StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Validity (days)" FontWeight="Bold"/><TextBox x:Name="DaysBox" Text="365" Margin="0,5,0,12"/><TextBlock Text="Server Binding (optional)"/><TextBox x:Name="BindingBox" Margin="0,5,0,12"/><TextBlock Text="Features (comma separated)"/><TextBox x:Name="FeaturesBox" Text="LiveView,Recording,Playback,PTZ,Export" Margin="0,5,0,12"/><Button Content="CREATE SIGNED LICENSE" Click="Create_Click" Height="45"/></StackPanel></Grid>
<Border Grid.Row="2" Background="{StaticResource Panel}" Padding="12" Margin="0,12,0,0"><TextBlock x:Name="StatusText" Text="Ready. Output will be written to the selected folder." TextWrapping="Wrap"/></Border>
</Grid></Window>
