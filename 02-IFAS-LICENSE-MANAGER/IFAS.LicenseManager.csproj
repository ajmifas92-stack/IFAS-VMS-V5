<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IFAS.LicenseManager</RootNamespace>
    <AssemblyName>IFAS.LicenseManager</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.20" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.20">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>


  <ItemGroup>
    <Compile Remove="IFAS.LicenseCreator.Desktop/**/*.cs" />
    <None Remove="IFAS.LicenseCreator.Desktop/**/*" />
    <Page Remove="IFAS.LicenseCreator.Desktop/**/*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\05-IFAS-VMS-SHARED\IFAS.VMS.Shared.csproj" />
    <ProjectReference Include="..\06-IFAS-VMS-SECURITY\IFAS.VMS.Security.csproj" />
  </ItemGroup>
</Project>
