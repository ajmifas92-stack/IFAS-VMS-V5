<Window x:Class="IFAS.VMS.Client.CameraSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Settings"
        Width="720"
        Height="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="CameraTitle"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Stream"
                           VerticalAlignment="Center"
                           Margin="0,8"/>
                <ComboBox x:Name="StreamComboBox"
                          Grid.Row="0" Grid.Column="1"
                          Margin="0,5"
                          Height="32">
                    <ComboBoxItem Content="Main"/>
                    <ComboBoxItem Content="Sub"/>
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Resolution"
                           VerticalAlignment="Center"
                           Margin="0,8"/>
                <ComboBox x:Name="ResolutionComboBox"
                          Grid.Row="1" Grid.Column="1"
                          Margin="0,5"
                          Height="32"
                          IsEditable="True"/>

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="FPS"
                           VerticalAlignment="Center"
                           Margin="0,8"/>
                <TextBox x:Name="FpsBox"
                         Grid.Row="2" Grid.Column="1"
                         Margin="0,5"
                         Height="32"/>

                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="Bitrate (Kbps)"
                           VerticalAlignment="Center"
                           Margin="0,8"/>
                <TextBox x:Name="BitrateBox"
                         Grid.Row="3" Grid.Column="1"
                         Margin="0,5"
                         Height="32"/>

                <TextBlock Grid.Row="4" Grid.Column="0"
                           Text="Codec"
                           VerticalAlignment="Center"
                           Margin="0,8"/>
                <ComboBox x:Name="CodecComboBox"
                          Grid.Row="4" Grid.Column="1"
                          Margin="0,5"
                          Height="32"/>

                <TextBlock Grid.Row="5" Grid.Column="0"
                           Text="Quality"
                           VerticalAlignment="Center"
                           Margin="0,8"/>
                <TextBox x:Name="QualityBox"
                         Grid.Row="5" Grid.Column="1"
                         Margin="0,5"
                         Height="32"/>

                <TextBlock Grid.Row="6" Grid.Column="0"
                           Text="Current Status"
                           VerticalAlignment="Top"
                           Margin="0,12,0,8"/>
                <TextBlock x:Name="StatusBox"
                           Grid.Row="6" Grid.Column="1"
                           Margin="0,12,0,8"
                           TextWrapping="Wrap"/>

                <TextBlock Grid.Row="7" Grid.Column="0"
                           Text="Supported Values"
                           VerticalAlignment="Top"
                           Margin="0,8"/>
                <TextBlock x:Name="SupportedBox"
                           Grid.Row="7" Grid.Column="1"
                           Margin="0,8"
                           TextWrapping="Wrap"/>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button x:Name="CheckButton"
                    Content="CHECK CURRENT SETTINGS"
                    Width="210"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="CheckButton_Click"/>

            <Button x:Name="ChangeButton"
                    Content="CHANGE SETTINGS"
                    Width="170"
                    Height="40"
                    Click="ChangeButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
