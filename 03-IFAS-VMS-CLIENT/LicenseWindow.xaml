<Window x:Class="IFAS.VMS.Client.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IFAS VMS - License"
        Width="620"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#061426"
        Foreground="#EAF4FF">

    <Border Margin="25"
            Padding="25"
            Background="#091E32"
            BorderBrush="#1D527C"
            BorderThickness="1"
            CornerRadius="8">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="LICENSE MANAGEMENT"
                           FontSize="25"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="StatusText"
                           Text="Checking license..."
                           FontSize="14"
                           Foreground="#79BFFF"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <Border Grid.Row="2"
                    Padding="18"
                    Background="#061426"
                    BorderBrush="#1D527C"
                    BorderThickness="1"
                    CornerRadius="6">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Customer"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               x:Name="CustomerText"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="1"
                               Text="Max Users"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               x:Name="MaxUsersText"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="2"
                               Text="Max Cameras"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="1"
                               x:Name="MaxCamerasText"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="3"
                               Text="Cameras"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="3"
                               Grid.Column="1"
                               x:Name="CameraUsageText"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="4"
                               Text="Expiry"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="4"
                               Grid.Column="1"
                               x:Name="ExpiryText"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Button x:Name="ImportButton"
                        Content="IMPORT LICENSE"
                        Width="170"
                        Height="42"
                        Margin="5"
                        FontWeight="Bold"
                        Click="Import_Click"/>

                <Button x:Name="RefreshButton"
                        Content="REFRESH"
                        Width="120"
                        Height="42"
                        Margin="5"
                        Click="Refresh_Click"/>
            </StackPanel>

            <TextBlock Grid.Row="5"
                       x:Name="MessageText"
                       Text=""
                       Foreground="#FFCC66"
                       TextWrapping="Wrap"
                       VerticalAlignment="Top"
                       Margin="5,15,5,5"/>

            <Button Grid.Row="6"
                    Content="CLOSE"
                    Width="110"
                    Height="38"
                    HorizontalAlignment="Right"
                    Click="Close_Click"/>
        </Grid>
    </Border>
</Window>
