{
  "Server": {
    "Name": "IFAS VMS Server",
    "Host": "0.0.0.0",
    "Port": 5080,
    "DatabasePath": "Data/ifas-vms.db"
  },
  "Security": {
    "JwtIssuer": "IFAS-VMS",
    "JwtAudience": "IFAS-VMS-Client",
    "JwtSecret": "CHANGE-THIS-TO-A-LONG-RANDOM-SECRET-IN-PRODUCTION",
    "TokenMinutes": 60,
    "PublicLicenseKeyPath": "Keys/license-public.pem"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
